  {
    "name": "bad-4x",
    "width": 1280,
    "status": 200,
    "geometry": {
      "bodyWidth": 1280,
      "scrollWidth": 1280,
      "bodyFont": "17px",
      "bodyLineHeight": "29.75px",
      "tableWidth": 798,
      "tableViewport": 798,
      "overflowElements": [],
      "headings": [
        {
          "text": "What makes a 4X game boring",
          "font": "76.8px"
        },
        {
          "text": "1. Activity expands while decisions disappear",
          "font": "28.8px"
        },
        {
          "text": "2. A wide menu hides one reliable answer",
          "font": "28.8px"
        },
        {
          "text": "3. Procedural scenery leaves the opening unchanged",
          "font": "28.8px"
        },
        {
          "text": "4. Randomness overwhelms agency—or changes nothing",
          "font": "28.8px"
        },
        {
          "text": "5. Exploration and events become a notification treadmill",
          "font": "28.8px"
        },
        {
          "text": "6. Rivals are arbitrary, exploitable or incapable",
          "font": "28.8px"
        },
        {
          "text": "7. The game continues long after its purpose is fulfilled",
          "font": "28.8px"
        },
        {
          "text": "8. Strategic difficulty comes from missing information",
          "font": "28.8px"
        },
        {
          "text": "9. Assistance quietly takes control away",
          "font": "28.8px"
        },
        {
          "text": "10. Production output is mistaken for engagement",
          "font": "28.8px"
        },
        {
          "text": "Use the guides to review a real game",
          "font": "28.8px"
        }
      ],
