      "overflowElements": [],
      "headings": [
        {
          "text": "What makes a good 4X game",
          "font": "76.8px"
        },
        {
          "text": "1. Choose the experience you are promising",
          "font": "28.8px"
        },
        {
          "text": "2. Make choices compete for something valuable",
          "font": "28.8px"
        },
        {
          "text": "3. Give uncertainty a job and room for a response",
          "font": "28.8px"
        },
        {
          "text": "4. Make a new campaign ask different questions",
          "font": "28.8px"
        },
        {
          "text": "5. Let discoveries change what the player cares about",
          "font": "28.8px"
        },
        {
          "text": "6. Give rivals coherent capabilities and readable motives",
          "font": "28.8px"
        },
        {
          "text": "7. Renew decisions as the empire grows",
          "font": "28.8px"
        },
        {
          "text": "8. Put the decision and its evidence together",
          "font": "28.8px"
        },
        {
          "text": "9. Reduce routine work while preserving intent",
          "font": "28.8px"
        },
        {
          "text": "10. Judge engagement with play, including the boring parts",
          "font": "28.8px"
        },
        {
          "text": "Use the guides to review a real game",
          "font": "28.8px"
        }
      ],
